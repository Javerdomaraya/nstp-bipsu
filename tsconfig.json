{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "frontend/src/**/*",
    "backend/src/**/*",
    "backend/test/**/*",
    "backend/scripts/**/*"
  ],
  "exclude": ["node_modules", "**/node_modules/*"]
}

