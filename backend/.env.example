PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE_NAME"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE_NAME"
JWT_SECRET="replace_with_a_high_entropy_jwt_secret"
JWT_EXPIRES_IN="24h"
ADMIN_EMAIL="replace_with_admin_email"
ADMIN_PASSWORD="replace_with_a_strong_admin_password"
# Used only by the deliberate `npm run admin:reset-password` command.
ADMIN_RESET_PASSWORD="set_only_for_an_intentional_reset"
ADMIN_RESET_CONFIRM="RESET_ADMIN_PASSWORD"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# For a Vercel frontend using a separate Render API domain in production.
COOKIE_SAME_SITE=none
# Production-only: shared rate-limit store and explicitly trusted reverse-proxy hops.
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace_with_upstash_token"
TRUST_PROXY_HOPS=1
