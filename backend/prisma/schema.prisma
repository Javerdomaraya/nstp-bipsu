generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  COORDINATOR
  INSTRUCTOR
  STUDENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum CoordinatorScope {
  CWTS
  MTS
  LTS
}

enum NSTPComponentType {
  CWTS
  LTS
  MTS_ARMY
  MTS_NAVY
  CWTS_COAST_GUARD
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  CREATED
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum PaymentPurpose {
  ENROLLMENT_FEE
}

enum ModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
}

enum AcademicSemester {
  FIRST
  SECOND
}

enum GradeClassification {
  EXCELLENT
  OUTSTANDING
  VERY_GOOD
  GOOD
  FAIR
  POOR
  CONDITIONAL
  FAILED
}

enum GradeInputType {
  PERCENT
  NUMERICAL
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  role               UserRole            @default(STUDENT)
  status             AccountStatus       @default(ACTIVE)
  data               Json?               @default("{}")
  studentProfile     StudentProfile?
  instructorProfile  InstructorProfile?
  coordinatorProfile CoordinatorProfile?
  following          Follow[]            @relation("FollowFollower")
  followers          Follow[]            @relation("FollowTarget")
  payments           Payment[]
  qualifyingAttempts QualifyingExamAttempt[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([role])
  @@map("user")
}

model StudentProfile {
  id             String           @id @default(cuid())
  userId         String           @unique
  studentNumber  String           @unique
  yearLevel      String?
  course         String?
  sectionId      String?
  componentId    String?
  data           Json?            @default("{}")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  section        Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  component      NSTPComponent?   @relation(fields: [componentId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]
  submissions    Submission[]
  grades         Grade[]
  moduleProgress ModuleProgress[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([sectionId])
  @@index([componentId])
  @@map("student_profile")
}

model InstructorProfile {
  id             String              @id @default(cuid())
  userId         String              @unique
  employeeNumber String?             @unique
  department     String?
  title          String?
  coordinatorId  String?
  componentId    String?
  municipalities String[]            @default([])
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  coordinator    CoordinatorProfile? @relation(fields: [coordinatorId], references: [id], onDelete: SetNull)
  component      NSTPComponent?      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  sections       Section[]
  modules        Module[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([coordinatorId])
  @@index([componentId])
  @@map("instructor_profile")
}

model CoordinatorProfile {
  id             String              @id @default(cuid())
  userId         String              @unique
  employeeNumber String?             @unique
  componentId    String?
  scope          CoordinatorScope
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  component      NSTPComponent?      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  facilitators   InstructorProfile[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([componentId])
  @@map("coordinator_profile")
}

model Section {
  id           String             @id @default(cuid())
  code         String             @unique
  name         String
  schoolYear   String
  semester     String
  componentId  String
  instructorId String?
  component    NSTPComponent      @relation(fields: [componentId], references: [id], onDelete: Restrict)
  instructor   InstructorProfile? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  students     StudentProfile[]
  enrollments  Enrollment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([componentId])
  @@index([instructorId])
  @@map("section")
}

model NSTPComponent {
  id           String               @id @default(cuid())
  type         NSTPComponentType    @unique
  name         String
  description  String?
  sections     Section[]
  modules      Module[]
  students     StudentProfile[]
  enrollments  Enrollment[]
  coordinators CoordinatorProfile[]
  facilitators InstructorProfile[]
  grades       Grade[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("nstp_component")
}

model Module {
  id           String             @id @default(cuid())
  title        String
  description  String?
  order        Int                @default(0)
  hours        Int?
  isPublished  Boolean            @default(false)
  status       ModuleStatus       @default(DRAFT)
  data         Json?              @default("{}")
  componentId  String?
  instructorId String?
  component    NSTPComponent?     @relation(fields: [componentId], references: [id], onDelete: SetNull)
  instructor   InstructorProfile? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  lessons      Lesson[]
  quizzes      Quiz[]
  assignments  Assignment[]
  exams        Exam[]
  grades       Grade[]
  progress     ModuleProgress[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([componentId])
  @@index([instructorId])
  @@index([status])
  @@map("module")
}

model Lesson {
  id          String       @id @default(cuid())
  moduleId    String
  title       String
  content     String?
  order       Int          @default(0)
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([moduleId])
  @@map("lesson")
}

model Quiz {
  id           String           @id @default(cuid())
  moduleId     String
  title        String
  instructions String?
  totalPoints  Int              @default(0)
  status       AssessmentStatus @default(DRAFT)
  data         Json?            @default("{}")
  module       Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions    Question[]
  submissions  Submission[]
  grades       Grade[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([moduleId])
  @@index([moduleId, status])
  @@map("quiz")
}

model Question {
  id        String   @id @default(cuid())
  quizId    String?
  examId    String?
  prompt    String
  options   Json?
  answer    Json?
  points    Int      @default(1)
  order     Int      @default(0)
  quiz      Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  exam      Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
  @@index([examId])
  @@map("question")
}

model Assignment {
  id           String       @id @default(cuid())
  moduleId     String
  title        String
  instructions String?
  dueDate      DateTime?
  totalPoints  Int          @default(100)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions  Submission[]
  grades       Grade[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([moduleId])
  @@map("assignment")
}

model Exam {
  id           String       @id @default(cuid())
  moduleId     String?
  title        String
  instructions String?
  totalPoints  Int          @default(100)
  startsAt     DateTime?
  endsAt       DateTime?
  module       Module?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  questions    Question[]
  submissions  Submission[]
  grades       Grade[]
  qualifyingAttempts QualifyingExamAttempt[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([moduleId])
  @@map("exam")
}

model Submission {
  id           String           @id @default(cuid())
  studentId    String
  lessonId     String?
  quizId       String?
  assignmentId String?
  examId       String?
  content      Json?
  score        Float?
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson       Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  quiz         Quiz?            @relation(fields: [quizId], references: [id], onDelete: SetNull)
  assignment   Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  exam         Exam?            @relation(fields: [examId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([studentId])
  @@index([lessonId])
  @@index([quizId])
  @@index([assignmentId])
  @@index([examId])
  @@map("submission")
}

model ModuleProgress {
  id          String         @id @default(cuid())
  studentId   String
  moduleId    String
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@index([moduleId])
  @@map("module_progress")
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  componentId String
  sectionId   String?
  schoolYear  String?
  semester    String?
  status      EnrollmentStatus @default(PENDING)
  enrolledAt  DateTime         @default(now())
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  component   NSTPComponent    @relation(fields: [componentId], references: [id], onDelete: Restrict)
  section     Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  payments    Payment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, componentId, sectionId])
  @@unique([studentId, componentId, schoolYear, semester])
  @@index([studentId])
  @@index([componentId])
  @@index([sectionId])
  @@index([schoolYear, semester])
  @@map("enrollment")
}

model Grade {
  id           String         @id @default(cuid())
  studentId    String
  moduleId     String?
  quizId       String?
  assignmentId String?
  examId       String?
  componentId  String?
  schoolYear   String?
  semester     AcademicSemester?
  percentGrade Float?
  numericalGrade Decimal?             @db.Decimal(2, 1)
  classification GradeClassification?
  inputType GradeInputType?
  inputValue Decimal?                  @db.Decimal(5, 2)
  gradeScaleVersion String?
  score        Float?
  prelim       Float?
  midterm      Float?
  final        Float?
  remarks      String?
  isReleased   Boolean        @default(false)
  releasedAt   DateTime?
  releasedById String?
  createdById  String?
  updatedById  String?
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module       Module?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  quiz         Quiz?          @relation(fields: [quizId], references: [id], onDelete: SetNull)
  assignment   Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  exam         Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  component    NSTPComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([studentId])
  @@index([moduleId])
  @@index([quizId])
  @@index([assignmentId])
  @@index([examId])
  @@index([componentId])
  @@index([isReleased])
  @@index([schoolYear, semester, isReleased])
  @@unique([studentId, componentId, schoolYear, semester])
  @@map("grade")
}

model PendingRegistration {
  id                   String             @id
  studentId            String?
  surname              String?
  firstName            String?
  middleName           String?
  name                 String
  email                String
  password             String?
  school               String?
  department           String?
  degreeProgram        String?
  yearLevel            String?
  major                String?
  gender               String?
  birthdate            String?
  houseStreetPurok     String?
  barangay             String?
  province             String?
  currentAddress       String?
  cityAddress          String?
  provincialAddress    String?
  contactNumber        String?
  municipality         String?
  assignedMunicipality String?
  status               RegistrationStatus @default(PENDING)
  rejectionReason      String?
  approvedById         String?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime           @default(now())

  @@index([status, createdAt])
  @@index([email])
  @@map("pending_registration")
}

model Province {
  code String @id
  name String

  @@map("province")
}

model Municipality {
  code         String @id
  name         String
  provinceCode String

  @@index([provinceCode])
  @@map("municipality")
}

model Barangay {
  code             String @id
  name             String
  municipalityCode String

  @@index([municipalityCode])
  @@map("barangay")
}

model Follow {
  id           String   @id @default(cuid())
  followerId   String
  targetUserId String
  createdAt    DateTime @default(now())
  follower     User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  targetUser   User     @relation("FollowTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([followerId, targetUserId])
  @@index([targetUserId])
  @@map("follow")
}

model Payment {
  id                 String         @id @default(cuid())
  userId             String
  targetEnrollmentId String
  amount             Decimal        @db.Decimal(12, 2)
  currency           String         @db.VarChar(3)
  purpose            PaymentPurpose
  idempotencyKey     String         @db.VarChar(128)
  status             PaymentStatus  @default(PENDING)
  providerReference  String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  targetEnrollment   Enrollment     @relation(fields: [targetEnrollmentId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([targetEnrollmentId])
  @@index([status])
  @@map("payment")
}

model TrainingGroup {
  id                 String   @id
  schoolYear         String
  semester           String
  component          String
  facilitatorName    String
  facilitatorId      String?
  programHandles     Json?
  municipality       String?
  studentCount       Int      @default(0)
  maxRecommendedLoad Int      @default(50)
  sourceDocument     String?
  createdAt          DateTime @default(now())

  @@index([schoolYear, semester])
  @@index([component])
  @@index([facilitatorId])
  @@map("training_group")
}

model AttendanceRecord {
  id            String   @id
  studentId     String
  sessionId     String
  status        String
  facilitatorId String
  updatedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([sessionId])
  @@index([studentId])
  @@index([facilitatorId])
  @@map("attendance_record")
}

model AttendanceSession {
  id            String   @id
  date          String
  facilitatorId String
  title         String
  createdAt     DateTime @default(now())

  @@index([facilitatorId])
  @@index([date])
  @@map("attendance_session")
}

model QualifyingExamResult {
  id                 String    @id
  userId             String
  userName           String
  userEmail          String
  preferredComponent String
  score              Int
  timestamp          String
  createdAt          DateTime  @default(now())
  assignedComponent  String?
  rank               Int?
  status             String?
  adminOverride      Boolean?
  attemptNumber      Int       @default(1)
  startedAt          DateTime? @default(now())
  expiresAt          DateTime?
  submittedAt        DateTime?

  @@index([userId])
  @@index([preferredComponent])
  @@index([status])
  @@map("qualifying_exam_result")
}

model QualifyingExamAttempt {
  id                 String    @id @default(cuid())
  userId             String
  userName           String?
  userEmail          String?
  examId             String?
  preferredComponent String
  score              Int?
  answers            Json?
  attemptNumber      Int       @default(1)
  startedAt          DateTime  @default(now())
  expiresAt          DateTime
  submittedAt        DateTime?
  status             String    @default("STARTED")
  assignedComponent  String?
  rank               Int?
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  exam               Exam?     @relation(fields: [examId], references: [id], onDelete: Restrict)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([examId])
  @@index([preferredComponent])
  @@index([status])
  @@map("qualifying_exam_attempt")
}

model ComponentApplicationState {
  id                String   @id
  slotLimits        Json
  qualifyingScore   Int      @default(70)
  applicationClosed Boolean  @default(false)
  schoolYear        String?
  semester          String?
  updatedAt         DateTime @default(now())

  @@map("component_application_state")
}

model AuditLogEntry {
  id        String   @id
  actor     String
  action    String
  detail    String?
  at        DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([at])
  @@map("audit_log_entry")
}

model ProfileExportTemplate {
  id            String         @id @default(cuid())
  templateKey   String         @default("student-profile")
  name          String
  version       Int
  status        TemplateStatus @default(DRAFT)
  isActive      Boolean        @default(false)
  configuration Json
  createdById   String
  updatedById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([templateKey, version])
  @@index([templateKey, status, createdAt])
  @@index([templateKey, isActive])
  @@map("profile_export_template")
}
