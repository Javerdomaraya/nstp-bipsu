{
  "name": "nstp-final-main",
  "private": true,
  "version": "1.0.0",
  "description": "NSTP Management System monorepo workspace",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "backend:dev": "npm run dev --workspace backend",
    "frontend:dev": "npm run dev --workspace frontend",
    "frontend:build": "npm run build --workspace frontend",
    "frontend:typecheck": "npm run typecheck --workspace frontend",
    "frontend:lint": "npm run lint --workspace frontend",
    "frontend:test": "npm run test --workspace frontend",
    "frontend:test:regression": "npm run test:regression --workspace frontend",
    "backend:lint": "npm run lint --workspace backend",
    "backend:test": "npm run test --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "migrate:deploy": "npm run migrate:deploy --workspace backend",
    "migrate:status": "npm run migrate:status --workspace backend",
    "migrate:recover": "npm run migrate:recover --workspace backend",
    "seed": "npm run seed --workspace backend",
    "admin:create": "npm run admin:create --workspace backend",
    "admin:reset-password": "npm run admin:reset-password --workspace backend",
    "report:orphans": "npm run report:orphans --workspace backend",
    "preflight:production": "npm run preflight:production --workspace backend",
    "verify:schema": "npm run verify:schema --workspace backend",
    "prisma:studio": "npm run prisma:studio --workspace backend",
    "build": "npm run frontend:build && npm run build --workspace backend"
  }
}
