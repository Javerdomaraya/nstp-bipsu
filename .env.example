# Docker Compose environment variables
# Copy this file to .env in the project root for docker-compose to pick it up.
# NOTE: docker-compose reads .env from the project root, NOT from backend/.env

POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=nstp_db

# Backend variables (also required in backend/.env for local dev)
DIRECT_URL=postgresql://replace_with_database_user:replace_with_a_strong_database_password@localhost:5432/nstp_db
JWT_SECRET=replace_with_a_high_entropy_jwt_secret
JWT_EXPIRES_IN=24h
ADMIN_EMAIL=replace_with_admin_email
ADMIN_PASSWORD=replace_with_a_strong_admin_password
CORS_ORIGIN=https://app.example.edu
